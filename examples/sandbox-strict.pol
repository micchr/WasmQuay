# wasmquay capability policy — strict sandbox
#
# Deny everything by default, then explicitly grant the minimum a
# well-behaved batch worker needs. See docs/FORMAT.md for the grammar.

policy "sandbox-strict"
default deny

# Wall/monotonic clock is harmless for timing and logging.
allow clock

# Standard streams for structured logging.
allow stdio

# Scratch filesystem, scoped to two directories.
allow fs: /tmp, /var/cache/worker

