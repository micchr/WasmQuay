// wasmquay WIT-like interface manifest (see docs/FORMAT.md).
// Describes an image-processing component's host requirements and surface.

package acme:image-pipeline@1.4.0

world processor {
    // Host requirements (imports).
    import wasi:filesystem/types
    import wasi:clocks/wall-clock
    import wasi:io/streams

    // Public surface (exports).
    export process: func(input: list<u8>) -> list<u8>
    export describe: func() -> string
}

world thumbnailer {
    import wasi:filesystem/types
    export thumbnail: func(input: list<u8>, size: u32) -> list<u8>
}
